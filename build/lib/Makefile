	cd /home/drizzt/Desktop/Projects/DAYAO/gpu/gr-cuda/build && $(MAKE) $(MAKESILENT) -f lib/CMakeFiles/gnuradio-cuda-cu.dir/build.make lib/CMakeFiles/gnuradio-cuda-cu.dir/stdfunc.cu.o
.PHONY : stdfunc.cu.o

stdfunc.i: stdfunc.cu.i
.PHONY : stdfunc.i

